<?xml version="1.0"?>
<package format="3">
  <name>so101_interfaces</name>
  <version>1.0.0</version>
  <description>ROS2 interfaces (srv) of the SO-ARM101 — DEDICATED package because rosidl
  generation requires ament_cmake (impossible in an ament_python package).</description>
  <maintainer email="tek5@epitech.eu">Tek5 Robotics</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>geometry_msgs</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
